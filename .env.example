# Kopyala: cp .env.example .env  (Windows: copy .env.example .env)
# Gercek .env dosyasi repoya girmez. Degisken listesi: docs/DEPLOYMENT.md §2

# --- postgres (docker compose) ---
POSTGRES_USER=campusflow
POSTGRES_PASSWORD=campusflow
POSTGRES_DB=campusflow
# Host'tan (pgAdmin/DBeaver) baglanmak icin; bilgisayarda kurulu PostgreSQL 5432'yi kullanir
POSTGRES_HOST_PORT=5433

# --- backend ---
ENVIRONMENT=local                # local|staging|production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://campusflow:campusflow@db:5432/campusflow
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
