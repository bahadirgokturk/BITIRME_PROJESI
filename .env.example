# Kopyala: cp .env.example .env  (Windows: copy .env.example .env)
# Gercek .env dosyasi repoya girmez. Degisken listesi: docs/DEPLOYMENT.md §2

# --- postgres (docker compose) ---
POSTGRES_USER=campusflow
POSTGRES_PASSWORD=campusflow
POSTGRES_DB=campusflow
# Host'tan (pgAdmin/DBeaver) baglanmak icin; bilgisayarda kurulu PostgreSQL 5432'yi kullanir
POSTGRES_HOST_PORT=5433

# --- backend ---
ENVIRONMENT=local                # local|staging|production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://campusflow:campusflow@db:5432/campusflow
CORS_ORIGINS=http://localhost:3000
# Yalniz yerel gelistirme icin; staging/production'da bu deger kabul edilmez (uygulama baslamaz).
# Yeni anahtar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-only-secret-change-me-0000000000
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
# Demo kullanicilarinin parolasi (python -m seeds.run --demo). Yalniz yerel; production'da --demo reddedilir.
SEED_DEMO_PASSWORD=demo-parola-123

# Frontend bu dosyayi okumaz: varsayilanlari frontend/.env.development icinde
# (degistirmek icin frontend/.env.local olustur)
