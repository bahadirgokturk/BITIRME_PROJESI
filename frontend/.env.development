# Gelistirme varsayilanlari (gizli degil); next dev bu dosyayi otomatik okur.
# Kisisel degisiklik icin frontend/.env.local olustur (repoya girmez).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend'de henuz uygulanmamis endpoint'ler sahte cevap alir (src/mocks/handlers.ts)
NEXT_PUBLIC_API_MOCKING=enabled
# Sahte /auth/me hangi rolle donsun: REPORTER | STAFF | MANAGER | ADMIN
NEXT_PUBLIC_MOCK_ROLE=REPORTER
